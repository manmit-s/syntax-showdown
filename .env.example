# =============================================================================
# .env.example — Environment variable reference
# =============================================================================
# Copy this file to .env for local development with python-dotenv,
# OR copy .streamlit/secrets.toml.example to .streamlit/secrets.toml
# for native Streamlit secrets support.
#
# NEVER commit the real .env or secrets.toml to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_key_here


# -----------------------------------------------------------------------------
# Firebase / Firestore
# How to get these values:
#   1. Go to https://console.firebase.google.com/
#   2. Create a project (or open an existing one)
#   3. Enable Firestore Database (Native mode)
#   4. Go to Project Settings > Service Accounts
#   5. Click "Generate new private key" — download the JSON
#   6. Copy each field from that JSON into the variables below
# -----------------------------------------------------------------------------
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id

# Important: the real value is multi-line — wrap it in double quotes
# and keep the literal \n characters exactly as they appear in the JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=000000000000000000000
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com


# -----------------------------------------------------------------------------
# Optional — only needed if you extend the app to load secrets from .env
# directly instead of via Streamlit secrets. See README for details.
# -----------------------------------------------------------------------------
# APP_ENV=development
# LOG_LEVEL=INFO
